{
  "schema": 1,
  "id": "secret-list",
  "root": {
    "id": "secrets",
    "type": "list",
    "bind": "secrets",
    "key": "name",
    "display": [
      "name",
      "updatedAt"
    ],
    "columnOptions": {
      "updatedAt": {
        "shortHeading": {
          "package": "the8020/admin-core",
          "key": "layout.updated",
          "fallback": "Updated"
        }
      }
    },
    "toolbar": [
      {
        "id": "add",
        "label": {
          "package": "the8020/admin-core",
          "key": "layout.add_secret",
          "fallback": "Add secret"
        },
        "kind": "primary"
      },
      {
        "id": "refresh",
        "label": {
          "package": "the8020/admin-core",
          "key": "layout.icon_refresh_refresh",
          "fallback": "[[icon=refresh]] Refresh"
        }
      }
    ]
  }
}
