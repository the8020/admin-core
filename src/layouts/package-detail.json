{
  "schema": 1,
  "id": "package-detail",
  "root": {
    "id": "package",
    "type": "stack",
    "children": [
      {
        "id": "overview",
        "type": "detail",
        "controls": [
          "description",
          "status",
          "license",
          "documentation",
          "issue"
        ]
      },
      {
        "id": "services",
        "type": "list",
        "title": "Services",
        "bind": "services",
        "key": "id",
        "display": [
          "description",
          "state",
          "workers"
        ],
        "columnOptions": {
          "description": {
            "length": "long"
          },
          "workers": {
            "length": "compact"
          }
        }
      },
      {
        "id": "programs",
        "type": "list",
        "title": "Programs",
        "bind": "programs",
        "key": "id",
        "display": [
          "description",
          "kind"
        ],
        "columnOptions": {
          "description": {
            "length": "long"
          }
        }
      }
    ]
  }
}
