{
  "schema": 1,
  "id": "package-list",
  "root": {
    "id": "packages",
    "type": "list",
    "bind": "packages",
    "key": "canonicalName",
    "selection": "selected",
    "display": [
      "canonicalName",
      "updates",
      "status",
      "services",
      "description"
    ],
    "columnOptions": {
      "canonicalName": {
        "shortHeading": "Package"
      },
      "services": {
        "length": "compact",
        "shortHeading": "S"
      },
      "description": {
        "length": "long"
      }
    },
    "toolbar": [
      {
        "id": "install",
        "label": "Install package",
        "kind": "primary"
      },
      {
        "id": "local",
        "label": "Create local package"
      },
      {
        "id": "fetch",
        "label": "Fetch"
      },
      {
        "id": "update",
        "label": "Update"
      },
      {
        "id": "refresh",
        "label": "[[icon=refresh]] Refresh"
      }
    ]
  }
}
