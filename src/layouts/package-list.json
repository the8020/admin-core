{
  "schema": 1,
  "id": "package-list",
  "root": {
    "id": "packages",
    "type": "list",
    "bind": "packages",
    "key": "canonicalName",
    "selection": "selected",
    "display": [
      "canonicalName",
      "version",
      "updates",
      "status"
    ],
    "columnOptions": {
      "canonicalName": {
        "shortHeading": {
          "package": "the8020/admin-core",
          "key": "layout.package",
          "fallback": "Package"
        }
      }
    },
    "toolbar": [
      {
        "id": "install",
        "label": {
          "package": "the8020/admin-core",
          "key": "layout.install_package",
          "fallback": "Install package"
        },
        "kind": "primary"
      },
      {
        "id": "local",
        "label": {
          "package": "the8020/admin-core",
          "key": "layout.create_local_package",
          "fallback": "Create local package"
        }
      },
      {
        "id": "fetch",
        "label": {
          "package": "the8020/admin-core",
          "key": "layout.fetch",
          "fallback": "Fetch"
        }
      },
      {
        "id": "update",
        "label": {
          "package": "the8020/admin-core",
          "key": "layout.update",
          "fallback": "Update"
        }
      },
      {
        "id": "sync",
        "label": {
          "package": "the8020/admin-core",
          "key": "packages.synchronize",
          "fallback": "Synchronize"
        }
      },
      {
        "id": "export",
        "label": {
          "package": "the8020/admin-core",
          "key": "layout.export",
          "fallback": "Export"
        }
      },
      {
        "id": "import",
        "label": {
          "package": "the8020/admin-core",
          "key": "layout.import",
          "fallback": "Import"
        }
      },
      {
        "id": "refresh",
        "label": {
          "package": "the8020/admin-core",
          "key": "layout.icon_refresh_refresh",
          "fallback": "[[icon=refresh]] Refresh"
        }
      }
    ]
  }
}
