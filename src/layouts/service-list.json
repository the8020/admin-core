{
  "schema": 1,
  "id": "service-list",
  "root": {
    "id": "services",
    "type": "list",
    "bind": "services",
    "key": "serviceId",
    "display": [
      "serviceId",
      "state",
      "enabled",
      "versions",
      "sandboxes",
      "workers",
      "serviceType",
      "description"
    ],
    "columnOptions": {
      "serviceId": {
        "shortHeading": "Service"
      },
      "enabled": {
        "length": "compact",
        "shortHeading": "On"
      },
      "versions": {
        "length": "compact",
        "shortHeading": "V"
      },
      "sandboxes": {
        "length": "compact",
        "shortHeading": "S"
      },
      "workers": {
        "length": "compact",
        "shortHeading": "W"
      },
      "serviceType": {
        "shortHeading": "Type"
      },
      "description": {
        "length": "long"
      }
    }
  }
}
