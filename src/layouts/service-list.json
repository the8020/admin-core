{
  "schema": 1,
  "id": "service-list",
  "root": {
    "id": "services",
    "type": "list",
    "bind": "services",
    "key": "serviceId",
    "display": [
      "description",
      "serviceId",
      "state",
      "workers",
      "sandboxes"
    ],
    "columnOptions": {
      "description": {
        "length": "long"
      },
      "serviceId": {
        "length": "long"
      },
      "workers": {
        "length": "short"
      },
      "sandboxes": {
        "length": "short"
      }
    },
    "toolbar": [
      {
        "id": "refresh",
        "label": {
          "package": "the8020/admin-core",
          "key": "layout.icon_refresh_refresh",
          "fallback": "[[icon=refresh]] Refresh"
        }
      }
    ]
  }
}
