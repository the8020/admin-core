{
  "schema": 1,
  "id": "core-admin-program-list",
  "root": {
    "id": "programs",
    "type": "list",
    "bind": "programs",
    "key": "id",
    "display": [
      "description",
      "kind",
      "packageId"
    ],
    "columnOptions": {
      "packageId": {
        "heading": "Package",
        "length": "medium"
      },
      "description": {
        "heading": "Program",
        "length": "long"
      },
      "kind": {
        "heading": "Runs as",
        "length": "short"
      }
    },
    "toolbar": [
      {
        "id": "refresh",
        "label": {
          "package": "the8020/admin-core",
          "key": "layout.icon_refresh_refresh",
          "fallback": "[[icon=refresh]] Refresh"
        }
      }
    ]
  }
}
