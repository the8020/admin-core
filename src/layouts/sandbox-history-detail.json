{
  "schema": 1,
  "id": "sandbox-history-detail",
  "root": {
    "id": "history",
    "type": "stack",
    "children": [
      {
        "id": "archive-section",
        "type": "section",
        "title": "Archived sandbox",
        "children": [
          {
            "id": "identity",
            "type": "detail",
            "controls": [
              "historyId",
              "sandboxId",
              "nodeId",
              "createdAt",
              "type",
              "state",
              "reason",
              "failure",
              "archivedAt",
              "expiresAt"
            ]
          }
        ]
      },
      {
        "id": "logs-section",
        "type": "section",
        "title": "Logs",
        "children": [
          {
            "id": "logs",
            "type": "detail",
            "controls": ["logStatus", "logs"]
          }
        ]
      }
    ]
  }
}
