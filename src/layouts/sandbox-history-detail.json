{
  "schema": 1,
  "id": "sandbox-history-detail",
  "root": {
    "id": "history",
    "type": "stack",
    "children": [
      {
        "id": "archive-section",
        "type": "section",
        "title": {
          "package": "the8020/admin-core",
          "key": "layout.archived_sandbox",
          "fallback": "Archived sandbox"
        },
        "children": [
          {
            "id": "identity",
            "type": "detail",
            "controls": [
              "state",
              "reason",
              "failure",
              "archivedAt",
              "expiresAt"
            ]
          }
        ]
      },
      {
        "id": "logs-section",
        "type": "section",
        "title": {
          "package": "the8020/admin-core",
          "key": "layout.logs",
          "fallback": "Logs"
        },
        "children": [
          {
            "id": "logs",
            "type": "detail",
            "controls": [
              "logStatus",
              "logs"
            ]
          }
        ]
      }
    ]
  }
}
