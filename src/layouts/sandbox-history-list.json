{
  "schema": 1,
  "id": "sandbox-history-list",
  "root": {
    "id": "sandboxes",
    "type": "list",
    "bind": "sandboxes",
    "key": "historyId",
    "display": [
      "sandboxId",
      "type",
      "state",
      "reason",
      "archivedAt",
      "expiresAt",
      "logs",
      "logBytes"
    ],
    "columnOptions": {
      "sandboxId": {
        "shortHeading": "Sandbox"
      },
      "reason": {
        "length": "long"
      },
      "archivedAt": {
        "shortHeading": "Archived"
      },
      "expiresAt": {
        "shortHeading": "Expires"
      },
      "logBytes": {
        "length": "compact",
        "shortHeading": "Bytes"
      }
    }
  }
}
