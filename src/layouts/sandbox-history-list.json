{
  "schema": 1,
  "id": "sandbox-history-list",
  "root": {
    "id": "sandboxes",
    "type": "list",
    "bind": "sandboxes",
    "key": "historyId",
    "display": [
      "sandboxId",
      "state",
      "reason",
      "archivedAt"
    ],
    "columnOptions": {
      "sandboxId": {
        "shortHeading": {
          "package": "the8020/admin-core",
          "key": "layout.sandbox",
          "fallback": "Sandbox"
        }
      },
      "reason": {
        "length": "long"
      },
      "archivedAt": {
        "shortHeading": {
          "package": "the8020/admin-core",
          "key": "layout.archived",
          "fallback": "Archived"
        }
      },
      "expiresAt": {
        "shortHeading": {
          "package": "the8020/admin-core",
          "key": "layout.expires",
          "fallback": "Expires"
        }
      }
    }
  }
}
