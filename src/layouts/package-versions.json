{
  "schema": 1,
  "id": "package-versions",
  "root": {
    "id": "versions",
    "type": "stack",
    "children": [
      {
        "id": "selection",
        "type": "field-group",
        "controls": [
          "selection",
          "currentCommit",
          "source"
        ]
      },
      {
        "id": "versions-list",
        "type": "list",
        "title": "Recent versions",
        "bind": "versions",
        "key": "commit",
        "display": [
          "subject",
          "tags",
          "authoredAt",
          "current"
        ],
        "columnOptions": {
          "subject": {
            "heading": "Change",
            "length": "long"
          },
          "authoredAt": {
            "heading": "Date",
            "length": "medium"
          },
          "current": {
            "heading": "Installed",
            "length": "compact"
          }
        }
      }
    ]
  }
}
