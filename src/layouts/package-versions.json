{
  "schema": 1,
  "id": "package-versions",
  "root": {
    "id": "versions",
    "type": "stack",
    "children": [
      {
        "id": "selection",
        "type": "field-group",
        "controls": [
          "selection",
          "currentCommit",
          "source"
        ]
      },
      {
        "id": "versions-list",
        "type": "list",
        "title": {
          "package": "the8020/admin-core",
          "key": "layout.recent_versions",
          "fallback": "Recent versions"
        },
        "bind": "versions",
        "key": "commit",
        "display": [
          "subject",
          "tags",
          "authoredAt",
          "current"
        ],
        "columnOptions": {
          "subject": {
            "heading": "Change",
            "length": "long"
          },
          "authoredAt": {
            "heading": "Date",
            "length": "medium"
          },
          "current": {
            "heading": "Installed",
            "length": "compact"
          }
        },
        "toolbar": [
          {
            "id": "refresh",
            "label": {
              "package": "the8020/admin-core",
              "key": "layout.icon_refresh_refresh",
              "fallback": "[[icon=refresh]] Refresh"
            }
          },
          {
            "id": "save",
            "label": {
              "package": "the8020/admin-core",
              "key": "layout.apply_version",
              "fallback": "Apply version"
            },
            "kind": "primary"
          }
        ]
      }
    ]
  }
}
