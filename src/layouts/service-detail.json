{
  "schema": 1,
  "id": "service-detail",
  "root": {
    "id": "service",
    "type": "stack",
    "children": [
      {
        "id": "identity",
        "type": "detail",
        "title": "Status",
        "controls": [
          "serviceId",
          "description",
          "path",
          "state",
          "enabled",
          "executionMode",
          "accessMode",
          "desiredGeneration",
          "loadedGeneration",
          "failure"
        ]
      },
      {
        "id": "configuration",
        "type": "grid",
        "columns": 3,
        "responsive": "stack",
        "children": [
          {
            "id": "instances",
            "type": "section",
            "title": "Instances",
            "controls": [
              "instancesMinimum",
              "instancesDesired",
              "instancesMaximum"
            ]
          },
          {
            "id": "workers",
            "type": "section",
            "title": "Workers",
            "controls": [
              "workersMinimum",
              "workersDesired",
              "workersMaximum",
              "maxInFlight"
            ]
          },
          {
            "id": "runtime",
            "type": "section",
            "title": "Runtime",
            "controls": [
              "requestTimeout",
              "drainTimeout",
              "idleTimeout",
              "dependencyMode",
              "groupKey"
            ]
          }
        ]
      },
      {
        "id": "sandboxes",
        "type": "list",
        "title": "Sandboxes",
        "bind": "sandboxes",
        "key": "navigation",
        "display": [
          "sandboxId",
          "state",
          "workers",
          "activeRequests",
          "activeSessions"
        ]
      }
    ]
  }
}
