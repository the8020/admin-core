{
  "schema": 1,
  "id": "service-detail",
  "root": {
    "id": "service",
    "type": "stack",
    "children": [
      {
        "id": "overview",
        "type": "detail",
        "controls": [
          "description",
          "state",
          "enabled",
          "path",
          "accessMode",
          "packageId",
          "workerCount",
          "sandboxCount",
          "failure"
        ],
        "actions": [
          "package"
        ]
      },
      {
        "id": "sandboxes",
        "type": "list",
        "title": "Running capacity",
        "bind": "sandboxes",
        "key": "navigation",
        "display": [
          "sandboxId",
          "workers",
          "activeRequests",
          "activeExecutions"
        ],
        "columnOptions": {
          "sandboxId": {
            "length": "long"
          },
          "activeRequests": {
            "shortHeading": "Requests",
            "length": "short"
          },
          "activeExecutions": {
            "shortHeading": "Executions",
            "length": "short"
          },
          "workers": {
            "length": "short"
          }
        }
      }
    ]
  }
}
