{
  "schema": 1,
  "id": "service-detail",
  "root": {
    "id": "service",
    "type": "stack",
    "children": [
      {
        "id": "identity",
        "type": "detail",
        "title": "Status",
        "controls": [
          "serviceId",
          "description",
          "path",
          "state",
          "enabled",
          "accessMode",
          "desiredGeneration",
          "loadedGeneration",
          "failure"
        ]
      },
      {
        "id": "scaling-section",
        "type": "section",
        "title": "Scaling",
        "children": [
          {
            "id": "scaling",
            "type": "grid",
            "columns": 3,
            "responsive": "stack",
            "children": [
              {
                "id": "worker-threads",
                "type": "field-group",
                "title": "Worker threads",
                "controls": [
                  "minimumWorkers",
                  "maximumWorkers"
                ]
              },
              {
                "id": "single-worker",
                "type": "field-group",
                "title": "Single worker",
                "controls": [
                  "concurrencyPerWorker",
                  "targetUtilization",
                  "workerKeepAlive"
                ]
              },
              {
                "id": "replication",
                "type": "field-group",
                "title": "Replication",
                "controls": [
                  "sandboxGroup",
                  "minimumSandboxes",
                  "workersPerSandbox"
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "lifecycle-section",
        "type": "section",
        "title": "Lifecycle",
        "children": [
          {
            "id": "service-lifecycle",
            "type": "field-group",
            "title": "Service lifecycle",
            "controls": [
              "serviceType",
              "sessionKeepAlive"
            ]
          }
        ]
      },
      {
        "id": "sandboxes",
        "type": "list",
        "title": "Sandboxes",
        "bind": "sandboxes",
        "key": "navigation",
        "display": [
          "sandboxId",
          "state",
          "workers",
          "activeRequests",
          "activeExecutions"
        ]
      }
    ]
  }
}
