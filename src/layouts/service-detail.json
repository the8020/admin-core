{
  "schema": 1,
  "id": "service-detail",
  "root": {
    "id": "service",
    "type": "stack",
    "children": [
      {
        "id": "overview",
        "type": "detail",
        "controls": [
          "description",
          "state",
          "enabled",
          "path",
          "accessMode",
          "packageId",
          "workerCount",
          "sandboxCount",
          "heap",
          "cpu",
          "failure"
        ],
        "actions": [
          "package"
        ]
      },
      {
        "id": "sandboxes",
        "type": "list",
        "title": {
          "package": "the8020/admin-core",
          "key": "layout.running_capacity",
          "fallback": "Running capacity"
        },
        "bind": "sandboxes",
        "key": "navigation",
        "display": [
          "sandboxId",
          "workers",
          "activeRequests",
          "activeExecutions"
        ],
        "columnOptions": {
          "sandboxId": {
            "length": "long"
          },
          "activeRequests": {
            "shortHeading": {
              "package": "the8020/admin-core",
              "key": "layout.requests",
              "fallback": "Requests"
            },
            "length": "short"
          },
          "activeExecutions": {
            "shortHeading": {
              "package": "the8020/admin-core",
              "key": "layout.executions",
              "fallback": "Executions"
            },
            "length": "short"
          },
          "workers": {
            "length": "short"
          }
        }
      }
    ]
  }
}
