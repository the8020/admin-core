{
  "schema": 1,
  "id": "sandbox-list",
  "root": {
    "id": "sandboxes",
    "type": "list",
    "bind": "sandboxes",
    "key": "sandboxId",
    "display": [
      "sandboxId",
      "type",
      "state",
      "reason",
      "workers",
      "failure"
    ],
    "columnOptions": {
      "sandboxId": {
        "shortHeading": "Sandbox"
      },
      "reason": {
        "length": "long"
      },
      "workers": {
        "length": "compact",
        "shortHeading": "W"
      },
      "failure": {
        "length": "long"
      }
    }
  }
}
