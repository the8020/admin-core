{
  "schema": 1,
  "id": "sandbox-list",
  "root": {
    "id": "sandboxes",
    "type": "list",
    "bind": "sandboxes",
    "key": "sandboxId",
    "display": [
      "sandboxId",
      "reason",
      "state",
      "workers"
    ],
    "columnOptions": {
      "sandboxId": {
        "length": "long"
      },
      "reason": {
        "length": "long"
      },
      "workers": {
        "length": "short"
      }
    },
    "toolbar": [
      {
        "id": "refresh",
        "label": {
          "package": "the8020/admin-core",
          "key": "layout.icon_refresh_refresh",
          "fallback": "[[icon=refresh]] Refresh"
        }
      }
    ]
  }
}
