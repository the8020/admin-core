{
  "schema": 1,
  "id": "sandbox-detail",
  "root": {
    "id": "sandbox",
    "type": "stack",
    "children": [
      {
        "id": "identity",
        "type": "detail",
        "title": {
          "package": "the8020/admin-core",
          "key": "layout.status",
          "fallback": "Status"
        },
        "controls": [
          "state",
          "type",
          "reason",
          "workers",
          "activeRequests",
          "activeExecutions",
          "memory",
          "cpu",
          "failure"
        ]
      },
      {
        "id": "services",
        "type": "list",
        "title": {
          "package": "the8020/admin-core",
          "key": "layout.services",
          "fallback": "Services"
        },
        "bind": "services",
        "key": "navigation",
        "display": [
          "serviceId",
          "state",
          "workers"
        ],
        "columnOptions": {
          "serviceId": {
            "shortHeading": {
              "package": "the8020/admin-core",
              "key": "layout.service",
              "fallback": "Service"
            }
          },
          "enabled": {
            "length": "compact",
            "shortHeading": {
              "package": "the8020/admin-core",
              "key": "layout.on",
              "fallback": "On"
            }
          },
          "sandboxes": {
            "length": "compact",
            "shortHeading": {
              "package": "the8020/admin-core",
              "key": "layout.s",
              "fallback": "S"
            }
          },
          "workers": {
            "length": "short",
            "shortHeading": {
              "package": "the8020/admin-core",
              "key": "layout.w",
              "fallback": "W"
            }
          }
        }
      },
      {
        "id": "workers",
        "type": "list",
        "title": {
          "package": "the8020/admin-core",
          "key": "layout.workers",
          "fallback": "Workers"
        },
        "bind": "workerRows",
        "key": "workerId",
        "display": [
          "workerId",
          "owner",
          "state",
          "requests",
          "heap",
          "cpu"
        ],
        "columnOptions": {
          "workerId": {
            "length": "long"
          },
          "owner": {
            "length": "long"
          },
          "requests": {
            "length": "short"
          }
        }
      }
    ]
  }
}
