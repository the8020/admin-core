{
  "schema": 1,
  "id": "sandbox-detail",
  "root": {
    "id": "sandbox",
    "type": "stack",
    "children": [
      {
        "id": "identity",
        "type": "detail",
        "title": "Status",
        "controls": [
          "state",
          "type",
          "reason",
          "workers",
          "activeRequests",
          "activeExecutions",
          "memory",
          "cpu",
          "failure"
        ]
      },
      {
        "id": "services",
        "type": "list",
        "title": "Services",
        "bind": "services",
        "key": "navigation",
        "display": [
          "serviceId",
          "state",
          "workers"
        ],
        "columnOptions": {
          "serviceId": {
            "shortHeading": "Service"
          },
          "enabled": {
            "length": "compact",
            "shortHeading": "On"
          },
          "sandboxes": {
            "length": "compact",
            "shortHeading": "S"
          },
          "workers": {
            "length": "short",
            "shortHeading": "W"
          }
        }
      },
      {
        "id": "workers",
        "type": "list",
        "title": "Workers",
        "bind": "workerRows",
        "key": "workerId",
        "display": [
          "workerId",
          "owner",
          "state",
          "requests",
          "heap",
          "cpu"
        ],
        "columnOptions": {
          "workerId": {
            "length": "long"
          },
          "owner": {
            "length": "long"
          },
          "requests": {
            "length": "short"
          }
        }
      }
    ]
  }
}
