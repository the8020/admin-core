{
  "schema": 1,
  "id": "service-settings",
  "root": {
    "id": "settings",
    "type": "stack",
    "children": [
      {
        "id": "service-state",
        "type": "field-group",
        "title": {
          "package": "the8020/admin-core",
          "key": "layout.service",
          "fallback": "Service"
        },
        "controls": [
          "enabled",
          "accessMode",
          "anonymousUser",
          "serviceType"
        ]
      },
      {
        "id": "scaling-section",
        "type": "section",
        "title": {
          "package": "the8020/admin-core",
          "key": "layout.scaling",
          "fallback": "Scaling"
        },
        "children": [
          {
            "id": "scaling",
            "type": "grid",
            "columns": 3,
            "responsive": "stack",
            "children": [
              {
                "id": "worker-threads",
                "type": "field-group",
                "title": {
                  "package": "the8020/admin-core",
                  "key": "layout.worker_threads",
                  "fallback": "Worker threads"
                },
                "controls": [
                  "minimumWorkers",
                  "maximumWorkers"
                ]
              },
              {
                "id": "single-worker",
                "type": "field-group",
                "title": {
                  "package": "the8020/admin-core",
                  "key": "layout.single_worker",
                  "fallback": "Single worker"
                },
                "controls": [
                  "concurrencyPerWorker",
                  "targetUtilization",
                  "workerKeepAlive"
                ]
              },
              {
                "id": "replication",
                "type": "field-group",
                "title": {
                  "package": "the8020/admin-core",
                  "key": "layout.replication",
                  "fallback": "Replication"
                },
                "controls": [
                  "sandboxGroup",
                  "minimumSandboxes",
                  "workersPerSandbox"
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "lifecycle-section",
        "type": "section",
        "title": {
          "package": "the8020/admin-core",
          "key": "layout.lifecycle",
          "fallback": "Lifecycle"
        },
        "children": [
          {
            "id": "service-lifecycle",
            "type": "field-group",
            "title": {
              "package": "the8020/admin-core",
              "key": "layout.service_lifecycle",
              "fallback": "Service lifecycle"
            },
            "controls": [
              "sessionKeepAlive"
            ]
          }
        ]
      }
    ]
  }
}
