{
  "schema": 1,
  "id": "package-import",
  "root": {
    "id": "import-root",
    "type": "stack",
    "children": [
      {
        "id": "upload",
        "type": "field-group",
        "controls": [
          "file"
        ]
      },
      {
        "id": "packages",
        "type": "list",
        "bind": "packages",
        "key": "package",
        "selection": "selected",
        "display": [
          "package",
          "state",
          "version",
          "current",
          "source"
        ],
        "columnOptions": {
          "source": {
            "length": "long"
          }
        }
      }
    ]
  }
}
