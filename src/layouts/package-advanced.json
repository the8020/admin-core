{
  "schema": 1,
  "id": "package-advanced",
  "root": {
    "id": "package",
    "type": "stack",
    "children": [
      {
        "id": "overview-section",
        "type": "section",
        "title": {
          "package": "the8020/admin-core",
          "key": "layout.overview",
          "fallback": "Overview"
        },
        "children": [
          {
            "id": "overview",
            "type": "grid",
            "columns": 2,
            "responsive": "stack",
            "children": [
              {
                "id": "manifest",
                "type": "field-group",
                "title": {
                  "package": "the8020/admin-core",
                  "key": "layout.package",
                  "fallback": "Package"
                },
                "controls": [
                  "packageId",
                  "path",
                  "description",
                  "documentationUrl",
                  "license",
                  "valid",
                  "serviceCount",
                  "programCount",
                  "fileCount",
                  "validation",
                  "inspection"
                ]
              },
              {
                "id": "repository",
                "type": "field-group",
                "title": {
                  "package": "the8020/admin-core",
                  "key": "layout.git_repository",
                  "fallback": "Git repository"
                },
                "controls": [
                  "repositoryStatus",
                  "activationReady",
                  "clean",
                  "branch",
                  "head",
                  "remoteName",
                  "remoteUrl",
                  "secretName"
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "contents-section",
        "type": "section",
        "title": {
          "package": "the8020/admin-core",
          "key": "layout.contents",
          "fallback": "Contents"
        },
        "children": [
          {
            "id": "contents",
            "type": "stack",
            "children": [
              {
                "id": "services",
                "type": "list",
                "title": {
                  "package": "the8020/admin-core",
                  "key": "layout.services",
                  "fallback": "Services"
                },
                "bind": "services",
                "key": "navigation",
                "display": [
                  "serviceId",
                  "serviceType",
                  "access",
                  "entrypoint",
                  "valid",
                  "description"
                ],
                "columnOptions": {
                  "serviceId": {
                    "shortHeading": {
                      "package": "the8020/admin-core",
                      "key": "layout.service",
                      "fallback": "Service"
                    }
                  },
                  "serviceType": {
                    "shortHeading": {
                      "package": "the8020/admin-core",
                      "key": "layout.type",
                      "fallback": "Type"
                    }
                  },
                  "entrypoint": {
                    "length": "long"
                  },
                  "description": {
                    "length": "long"
                  }
                }
              },
              {
                "id": "programs",
                "type": "list",
                "title": {
                  "package": "the8020/admin-core",
                  "key": "layout.programs",
                  "fallback": "Programs"
                },
                "bind": "programs",
                "key": "programId",
                "display": [
                  "programId",
                  "entrypoint",
                  "defaultLayout",
                  "discoverable",
                  "uui",
                  "valid",
                  "description"
                ],
                "columnOptions": {
                  "programId": {
                    "shortHeading": {
                      "package": "the8020/admin-core",
                      "key": "layout.program",
                      "fallback": "Program"
                    }
                  },
                  "entrypoint": {
                    "length": "long"
                  },
                  "description": {
                    "length": "long"
                  }
                }
              },
              {
                "id": "files",
                "type": "list",
                "title": {
                  "package": "the8020/admin-core",
                  "key": "layout.files",
                  "fallback": "Files"
                },
                "bind": "files",
                "key": "path",
                "display": [
                  "path",
                  "type",
                  "size"
                ],
                "columnOptions": {
                  "path": {
                    "length": "long"
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
